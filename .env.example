# SH Ads Desk — environment configuration. Copy this file to ".env" on YOUR
# server and fill in your own values. NEVER commit .env, never share it,
# never paste these values into chat. The app reads secrets ONLY from here.

# --- Web server ---
# HOST: 127.0.0.1 for local/reverse-proxy use; Docker sets 0.0.0.0 itself.
HOST=127.0.0.1
# PORT: port the app listens on.
PORT=8000
# COOKIE_SECURE: set to 1 when the app is served over HTTPS (recommended).
COOKIE_SECURE=0

# --- Owner login ---
# OWNER_PASSWORD_HASH (optional): if set, it replaces the first-run /setup
# password. Generate it with:  python -m app.auth hash
# Leave empty to use the /setup page on first run instead. ONE of the two —
# never write a plain password anywhere.
OWNER_PASSWORD_HASH=

# --- Redis (optional fast lane for the 24x7 worker) ---
# REDIS_URL: docker-compose ise apne aap set karta hai
# (redis://redis:6379/0). Khud ke server par Redis ho to yahan do.
# Khaali/unreachable ho to system SQLite queue par chalega — Redis
# kabhi hard dependency nahi hai.
REDIS_URL=

# --- Data location ---
# SH_ADS_DATA_DIR: where state.db, saved settings and uploads live.
# Default: ./data inside the app folder. Back THIS folder up (it has no secrets).
SH_ADS_DATA_DIR=

# --- Meta connection (Steps 2–4 of the brief) ---
# META_MODE: MOCK (default, safe) or LIVE. Keep MOCK until Step 3 read-only
# comparison against Ads Manager has passed. LIVE code is UNTESTED.
META_MODE=MOCK
# META_ACCESS_TOKEN: token from Meta's OWN developer screens (least
# privilege: ads_read first; ads_management only after Step 4 approval).
# The app never asks for this in the UI and never logs it.
META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID: your ad account id (digits, with or without act_ prefix).
META_AD_ACCOUNT_ID=
# META_PAGE_ID: your Facebook Page id (used by the Connect wizard status).
META_PAGE_ID=

# --- API Providers (optional — owner's OWN generation APIs) ---
# Keys for the APIs YOU connect on the app's "API Providers" page
# (OpenAI/Claude for text, an image API, Higgsfield/Kling-style for video).
# Two ways to set them — env here wins over the UI:
#   1) Yahan env me rakho (neeche), ya
#   2) App ke API Providers page par paste karo — tab keys server ki
#      data/secrets.env file me save hongi (chmod 600, git-ignored).
# Ek hi tareeka use karo taaki confusion na ho. Keys kabhi chat/commit/
# settings/DB/log me nahi jati.
SH_ADS_TEXT_API_KEY=
SH_ADS_IMAGE_API_KEY=
SH_ADS_VIDEO_API_KEY=
